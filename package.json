    "serve": "python3 -m http.server 8000",
    "test": "python3 test/run_all.py"
  },
  "devDependencies": {
    "@fontsource/anuphan": "^5.3.0",
    "@fontsource/mitr": "^5.3.0",
    "three": "0.160.0"
  }
}
